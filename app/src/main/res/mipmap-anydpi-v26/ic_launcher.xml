<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). Background is the full-bleed pastel pattern;
  the foreground glyph is inset into the safe zone by
  drawable/ic_launcher_foreground_layer; monochrome supplies the Android 13+
  themed-icon silhouette. Pre-26 launchers fall back to the mipmap webps.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_layer" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
