<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive round launcher icon (API 26+). Same layers as ic_launcher.xml; the
  launcher applies its own circular/squircle mask. Pre-26 launchers use the
  pre-masked ic_launcher_round webps.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_layer" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
